    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "csrf-csrf": "^4.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
