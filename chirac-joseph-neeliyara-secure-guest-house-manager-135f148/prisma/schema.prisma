generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CLEANER
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  ONLINE
  PHONE
  WALK_IN
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum CleaningStatus {
  PENDING
  IN_PROGRESS
  AWAITING_VERIFICATION
  COMPLETED
  ISSUE_REPORTED
}

enum InventoryTxnType {
  ADDITION
  CONSUMPTION
  ADJUSTMENT
  DAMAGED
  LOST
  ASSIGNED_TO_ROOM
  RETURNED_FROM_ROOM
}

enum InventoryVerificationStatus {
  VERIFIED
  MISSING
  DAMAGED
  MISMATCH
}

enum InventoryDiscrepancyStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum MaintenanceIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum FilePurpose {
  CLEANING_PHOTO
  MAINTENANCE_PHOTO
  INVENTORY_REFERENCE
  INVENTORY_VERIFICATION
  OTHER
}

enum DataSubjectRequestType {
  ACCESS
  CORRECTION
  DELETION
  EXPORT
  OBJECTION
}

enum DataSubjectRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String     @unique @db.VarChar(320)
  name                 String     @db.VarChar(200)
  passwordHash         String     @map("password_hash")
  role                 UserRole   @default(CLEANER)
  status               UserStatus @default(PENDING)
  canViewFinancials    Boolean    @default(false) @map("can_view_financials")
  mfaEnabled           Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEnc         String?    @map("mfa_secret_enc")
  failedLoginAttempts  Int        @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?  @map("locked_until")
  passwordChangedAt    DateTime?  @map("password_changed_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  createdById          String?    @map("created_by_id") @db.Uuid

  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  cleaningTasks            CleaningTask[]           @relation("AssignedCleaner")
  cleaningTasksVerified    CleaningTask[]           @relation("CleaningVerifier")
  inventoryTransactions    InventoryTransaction[]
  inventoryVerifications   InventoryVerification[]  @relation("InventoryVerifiedBy")
  maintenanceIssues        MaintenanceIssue[]       @relation("ReportedBy")
  auditLogs                AuditLog[]
  uploadedFiles            StoredFile[]
  inventoryPermissions     UserInventoryPermission[]
  mfaRecoveryCodes         MfaRecoveryCode[]
  mfaLoginChallenges       MfaLoginChallenge[]

  @@map("users")
}

model MfaLoginChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_login_challenges")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(100)
  description String @db.VarChar(500)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         UserRole
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model RoomType {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique @db.VarChar(100)
  description     String?  @db.VarChar(500)
  maxGuests       Int      @default(2) @map("max_guests")
  baseRate        Decimal  @default(0) @map("base_rate") @db.Decimal(12, 2)
  extraBedAllowed Boolean  @default(false) @map("extra_bed_allowed")
  extraBedRate    Decimal  @default(0) @map("extra_bed_rate") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  rooms Room[]

  @@map("room_types")
}

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  roomTypeId  String   @map("room_type_id") @db.Uuid
  floor       String?  @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roomType        RoomType         @relation(fields: [roomTypeId], references: [id])
  bookingRooms    BookingRoom[]
  cleaningTasks   CleaningTask[]
  maintenanceIssues MaintenanceIssue[]
  roomInventories RoomInventory[]
  inventoryVerifications InventoryVerification[]
  inventoryTransactions InventoryTransaction[]

  @@index([roomTypeId])
  @@map("rooms")
}

model Guest {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(200)
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(30)
  emailNormalized String? @map("email_normalized") @db.VarChar(320)
  phoneNormalized String? @map("phone_normalized") @db.VarChar(20)
  address   String?  @db.VarChar(500)
  idType    String?  @map("id_type") @db.VarChar(50)
  idNumber  String?  @map("id_number") @db.VarChar(100)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  anonymizedAt DateTime? @map("anonymized_at")

  bookings Booking[]

  @@index([email])
  @@index([phone])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@map("guests")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  reference     String        @unique @db.VarChar(20)
  guestId       String        @map("guest_id") @db.Uuid
  checkIn       DateTime      @map("check_in")
  checkOut      DateTime      @map("check_out")
  guestCount    Int           @default(1) @map("guest_count")
  status        BookingStatus @default(PENDING)
  source        BookingSource @default(DIRECT)
  isWholeHouse  Boolean       @default(false) @map("is_whole_house")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  amountTotal   Decimal       @default(0) @map("amount_total") @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  roomNightlyRate Decimal     @default(0) @map("room_nightly_rate") @db.Decimal(12, 2)
  roomStayTotal Decimal       @default(0) @map("room_stay_total") @db.Decimal(12, 2)
  extraBedCount Int           @default(0) @map("extra_bed_count")
  extraBedNightlyRate Decimal @default(0) @map("extra_bed_nightly_rate") @db.Decimal(12, 2)
  extraBedTotal Decimal       @default(0) @map("extra_bed_total") @db.Decimal(12, 2)
  notes         String?       @db.Text
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdById   String?       @map("created_by_id") @db.Uuid
  cancelledAt   DateTime?     @map("cancelled_at")

  guest          Guest           @relation(fields: [guestId], references: [id])
  bookingRooms   BookingRoom[]
  cleaningTasks  CleaningTask[]
  payments       Payment[]

  @@index([checkIn, checkOut])
  @@index([guestId])
  @@index([status])
  @@map("bookings")
}

model BookingRoom {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  roomId    String @map("room_id") @db.Uuid

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])

  @@unique([bookingId, roomId])
  @@index([roomId])
  @@map("booking_rooms")
}

model CleaningTask {
  id               String         @id @default(uuid()) @db.Uuid
  roomId           String         @map("room_id") @db.Uuid
  bookingId        String?        @map("booking_id") @db.Uuid
  assignedToId     String?        @map("assigned_to_id") @db.Uuid
  status           CleaningStatus @default(PENDING)
  dueAt            DateTime?      @map("due_at")
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  submittedForVerificationAt DateTime? @map("submitted_for_verification_at")
  verifiedById     String?        @map("verified_by_id") @db.Uuid
  verifiedAt       DateTime?      @map("verified_at")
  submissionMeta   Json?          @map("submission_meta")
  completionPhotoId String?       @unique @map("completion_photo_id") @db.Uuid
  notes            String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  room            Room         @relation(fields: [roomId], references: [id])
  booking         Booking?     @relation(fields: [bookingId], references: [id])
  assignedTo      User?        @relation("AssignedCleaner", fields: [assignedToId], references: [id])
  verifiedBy      User?        @relation("CleaningVerifier", fields: [verifiedById], references: [id])
  completionPhoto StoredFile?  @relation("CleaningCompletionPhoto", fields: [completionPhotoId], references: [id])
  photos          CleaningPhoto[]

  @@index([assignedToId, status])
  @@index([roomId])
  @@map("cleaning_tasks")
}

model CleaningPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  cleaningTaskId String   @map("cleaning_task_id") @db.Uuid
  fileId         String   @map("file_id") @db.Uuid
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  cleaningTask CleaningTask @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation(fields: [fileId], references: [id])

  @@index([cleaningTaskId])
  @@map("cleaning_photos")
}

model InventoryCategory {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.VarChar(100)
  description String? @db.VarChar(500)

  items InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(200)
  categoryId      String   @map("category_id") @db.Uuid
  quantity        Int      @default(0)
  minimumThreshold Int     @default(0) @map("minimum_threshold")
  unit            String   @db.VarChar(50)
  location        String?  @db.VarChar(200)
  allowNegative   Boolean  @default(false) @map("allow_negative")
  referencePhotoId String?  @unique @map("reference_photo_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category     InventoryCategory      @relation(fields: [categoryId], references: [id])
  referencePhoto StoredFile?          @relation("InventoryReferencePhoto", fields: [referencePhotoId], references: [id])
  transactions InventoryTransaction[]
  roomInventories RoomInventory[]
  verifications InventoryVerification[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("inventory_items")
}

model RoomInventory {
  id               String   @id @default(uuid()) @db.Uuid
  roomId           String   @map("room_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  expectedQuantity Int      @default(0) @map("expected_quantity")
  assignedQuantity Int      @default(0) @map("assigned_quantity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  room Room          @relation(fields: [roomId], references: [id])
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([roomId, itemId])
  @@index([itemId])
  @@map("room_inventory")
}

model InventoryVerification {
  id                 String                      @id @default(uuid()) @db.Uuid
  roomId             String                      @map("room_id") @db.Uuid
  itemId             String                      @map("item_id") @db.Uuid
  expectedQuantity   Int                         @map("expected_quantity")
  foundQuantity      Int                         @map("found_quantity")
  status             InventoryVerificationStatus
  discrepancyStatus  InventoryDiscrepancyStatus  @default(OPEN) @map("discrepancy_status")
  photoFileId        String                      @map("photo_file_id") @db.Uuid
  verifiedById       String                      @map("verified_by_id") @db.Uuid
  notes              String?                     @db.Text
  resolvedAt         DateTime?                   @map("resolved_at")
  resolvedById       String?                     @map("resolved_by_id") @db.Uuid
  createdAt          DateTime                    @default(now()) @map("created_at")

  room       Room          @relation(fields: [roomId], references: [id])
  item       InventoryItem @relation(fields: [itemId], references: [id])
  photo      StoredFile    @relation("InventoryVerificationPhoto", fields: [photoFileId], references: [id])
  verifiedBy User          @relation("InventoryVerifiedBy", fields: [verifiedById], references: [id])

  @@index([roomId, itemId, createdAt])
  @@index([discrepancyStatus])
  @@map("inventory_verifications")
}

model UserInventoryPermission {
  userId        String @map("user_id") @db.Uuid
  canConsume    Boolean @default(false) @map("can_consume")
  canAdjust     Boolean @default(false) @map("can_adjust")
  canView       Boolean @default(true) @map("can_view")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId])
  @@map("user_inventory_permissions")
}

model InventoryTransaction {
  id              String           @id @default(uuid()) @db.Uuid
  itemId          String           @map("item_id") @db.Uuid
  type            InventoryTxnType
  quantityChange  Int              @map("quantity_change")
  previousQty     Int              @map("previous_qty")
  newQty          Int              @map("new_qty")
  reason          String           @db.VarChar(500)
  roomId          String?          @map("room_id") @db.Uuid
  performedById   String           @map("performed_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  item        InventoryItem @relation(fields: [itemId], references: [id])
  performedBy User          @relation(fields: [performedById], references: [id])
  room        Room?         @relation(fields: [roomId], references: [id])

  @@index([itemId, createdAt])
  @@index([roomId, createdAt])
  @@map("inventory_transactions")
}

model MaintenanceIssue {
  id           String                 @id @default(uuid()) @db.Uuid
  roomId       String                 @map("room_id") @db.Uuid
  reportedById String                 @map("reported_by_id") @db.Uuid
  title        String                 @db.VarChar(200)
  description  String                 @db.Text
  status       MaintenanceIssueStatus @default(OPEN)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  resolvedAt   DateTime?              @map("resolved_at")

  room       Room                @relation(fields: [roomId], references: [id])
  reportedBy User                @relation("ReportedBy", fields: [reportedById], references: [id])
  photos     MaintenancePhoto[]

  @@index([roomId])
  @@map("maintenance_issues")
}

model MaintenancePhoto {
  id         String   @id @default(uuid()) @db.Uuid
  issueId    String   @map("issue_id") @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  issue MaintenanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  file  StoredFile       @relation(fields: [fileId], references: [id])

  @@map("maintenance_photos")
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @db.VarChar(50)
  reference   String?  @db.VarChar(100)
  notes       String?  @db.Text
  recordedAt  DateTime @default(now()) @map("recorded_at")
  recordedById String? @map("recorded_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([recordedAt])
  @@map("payments")
}

model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  category      String   @db.VarChar(100)
  amount        Decimal  @db.Decimal(12, 2)
  description   String   @db.Text
  paymentMethod String?  @map("payment_method") @db.VarChar(50)
  reference     String?  @db.VarChar(100)
  notes         String?  @db.Text
  incurredAt    DateTime @map("incurred_at")
  recordedAt    DateTime @default(now()) @map("recorded_at")
  recordedById  String?  @map("recorded_by_id") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([incurredAt])
  @@index([category])
  @@map("expenses")
}

model StoredFile {
  id           String      @id @default(uuid()) @db.Uuid
  purpose      FilePurpose
  storageKey   String      @unique @map("storage_key") @db.VarChar(500)
  mimeType     String      @map("mime_type") @db.VarChar(100)
  sizeBytes    Int         @map("size_bytes")
  uploadedById String      @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  expiresAt    DateTime?   @map("expires_at")

  uploadedBy            User           @relation(fields: [uploadedById], references: [id])
  cleaningPhotos        CleaningPhoto[]
  maintenancePhotos     MaintenancePhoto[]
  cleaningCompletionFor CleaningTask?  @relation("CleaningCompletionPhoto")
  inventoryReferenceFor InventoryItem? @relation("InventoryReferencePhoto")
  inventoryVerifications InventoryVerification[] @relation("InventoryVerificationPhoto")

  @@map("stored_files")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  action        String      @db.VarChar(100)
  resourceType  String?     @map("resource_type") @db.VarChar(100)
  resourceId    String?     @map("resource_id") @db.VarChar(100)
  result        AuditResult
  correlationId String?     @map("correlation_id") @db.VarChar(100)
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.VarChar(512)
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("system_settings")
}

model RetentionPolicy {
  id          String @id @default(uuid()) @db.Uuid
  dataCategory String @unique @map("data_category") @db.VarChar(100)
  retentionDays Int   @map("retention_days")
  description String? @db.VarChar(500)

  @@map("retention_policies")
}

model PrivacyNotice {
  id        String   @id @default(uuid()) @db.Uuid
  version   String   @unique @db.VarChar(20)
  content   String   @db.Text
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("privacy_notices")
}

model DataSubjectRequest {
  id          String                   @id @default(uuid()) @db.Uuid
  type        DataSubjectRequestType
  status      DataSubjectRequestStatus @default(PENDING)
  subjectEmail String                  @map("subject_email") @db.VarChar(320)
  details     String?                  @db.Text
  handledById String?                  @map("handled_by_id") @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at")
  completedAt DateTime?                @map("completed_at")

  @@map("data_subject_requests")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(200)
  body      String   @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}
