# Application
NODE_ENV=development
APP_URL=http://localhost:3847
PORT=3847

# Database (use least-privilege user in production)
# Percent-encode special characters in the password (e.g. ! as %21).
#
# DATABASE_URL — runtime / application database connection (Next.js, Prisma Client @prisma/adapter-pg).
# Local: direct Postgres. Hosted (e.g. Supabase + Vercel): typically the pooler URL for serverless runtime.
DATABASE_URL=postgresql://ghms:CHANGE_ME@127.0.0.1:5432/ghms?schema=public
#
# DIRECT_URL — Prisma CLI / migration database connection (prisma migrate, db pull, etc.).
# Hosted: direct/session Postgres (not the pooler). Optional locally; if unset, CLI uses DATABASE_URL.
# DIRECT_URL=postgresql://ghms:CHANGE_ME@127.0.0.1:5432/ghms?schema=public

# Session & security (generate with: openssl rand -base64 32)
SESSION_SECRET=CHANGE_ME_MIN_32_CHARS
CSRF_SECRET=CHANGE_ME_MIN_32_CHARS

# Cookie settings (set Secure=true in production behind HTTPS)
# In development, Secure cookies work on localhost but not on http://<LAN-IP> unless the app omits Secure (see cookie-options.ts).
COOKIE_SECURE=false
# Leave empty for LAN/mobile dev; never set to "localhost" when testing from other devices.
COOKIE_DOMAIN=

# LAN mobile dev (Next.js dev server — allows /_next assets from phones on your Wi‑Fi)
# ALLOWED_DEV_ORIGINS=192.168.0.109
# AUTH_FLOW_DEBUG=true
# Login credential diagnosis (userFound / passwordVerificationSucceeded, no secrets) always logs in development as auth.flow login.diag
# ALLOW_DEV_RATE_LIMIT_RESET=true

# File storage (local path for dev; S3-compatible for production)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Upload limits
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_WIDTH=4096
UPLOAD_MAX_HEIGHT=4096

# Rate limiting (set REDIS_URL in production/multi-instance)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
REDIS_URL=

# MFA (admin)
MFA_ENCRYPTION_KEY=
ADMIN_MFA_BOOTSTRAP=false

# Malware scanning (production)
MALWARE_SCAN_COMMAND=
MALWARE_SCAN_REQUIRED=false

# Development only
ALLOW_DEV_RESET_TOKEN_LOG=false

# Logging
LOG_LEVEL=info

# Optional local-development seed administrator only. Leave blank by default.
# Never configure seed credentials in staging or production; use the one-time admin bootstrap.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Backup (documented for ops — not used at runtime in app)
BACKUP_ENCRYPTION_KEY=
